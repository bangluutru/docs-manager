{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jds-business-documents",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jds-business-documents-local",
      "database_id": "local-development-database",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "DOCUMENT_ARTIFACTS", "bucket_name": "jds-documents-local" },
    { "binding": "BRAND_ASSETS", "bucket_name": "jds-assets-local" }
  ],
  "browser": { "binding": "BROWSER" },
  "vars": {
    "APP_ENV": "development",
    "ORGANIZATION_ID": "local-organization",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
